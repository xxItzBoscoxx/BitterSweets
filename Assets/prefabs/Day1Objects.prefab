MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1977672412432843532}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76bea0b18045d496087247b176a0ace8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    names:
    - Dog
    - Human
    - Human
    - Dog
    - Human
    - Dog
    - Human
    - Dog
    - Human
    - Narrator
    sentences:
    - '*Scratches at door*'
    - '*Shakes his head*'
    - I'm sorry, boy, but we can't go outside right now. It's not safe out there.
    - '*Whines and continues to scratch at the door*'
    - I know you want to go outside and play, but we can't. There was a nuclear explosion,
      and it's not safe for us to be outside.
    - '*Looks at the human, still not understanding*'
    - Trust me, buddy, I wish we could go outside too. But we have to stay in here
      to stay safe. We'll find something to do, I promise.
    - '*Whines again but eventually gives up and goes to lay down in his favorite
      spot*'
    - I wish I could explain everything to you, but I know you don't understand.
      I just want you to know that I'm here with you, and I'll do everything I can
      to keep us safe.
    - The human gets up and goes to the kitchen to prepare some food for the both
      of them. The dog watches him, still curious about what's going on outside but
      content to be with his human.
  itemsClicked: 0
  dialogueManager: {fileID: 0}
  humanButton: {fileID: 0}
