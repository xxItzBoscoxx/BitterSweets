--- !u!114 &1977672411808090217
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1977672411808090211}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76bea0b18045d496087247b176a0ace8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    names:
    - Dog
    - Human
    - Human
    - Human
    - Human
    - Dog
    - Human
    - Dog
    - Human
    - Dog
    - Human
    - Narrator
    sentences:
    - '*Paws at the empty bowl, looking up at the human with pleading eyes*'
    - Oh, I'm sorry buddy. I forgot to fill your bowl.
    - '*Gets up from the couch and walks over to the kitchen, grabbing a bag of dog
      food from the pantry*'
    - '*Pours some into the bowl and sets it down in front of the dog*'
    - There you go, buddy. Sorry about that.
    - '*Eagerly starts to eat, tail wagging as he enjoys his meal*'
    - I know it's not much, but I'll make sure you have enough food for the next
      few days. We have to be careful with what we have, though. We don't know when
      we'll be able to get more.
    - '*Finishes his meal and looks up at the human, his tongue lolling out of his
      mouth*'
    - You're such a good boy. I'm glad I have you here with me. You make everything
      a little bit easier.
    - '*Wags his tail and jumps up onto the couch next to the human, snuggling up
      against him*'
    - You're a good snuggler too, buddy.
    - 'The human strokes the dog''s fur, lost in thought as he wonders how they''ll
      make it through the next few days. But for now, they have each other, and that''s
      enough to keep them going.

'
  itemsClicked: 0
  dialogueManager: {fileID: 0}
  humanButton: {fileID: 0}
